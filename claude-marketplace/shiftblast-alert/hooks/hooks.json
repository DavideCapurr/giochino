{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify-shiftblast.sh stop"
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify-shiftblast.sh subagent-stop"
        }
      ]
    }
  ],
  "Notification": [
    {
      "matcher": "idle_prompt|permission_prompt",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify-shiftblast.sh notification"
        }
      ]
    }
  ],
  "StopFailure": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify-shiftblast.sh stop-failure"
        }
      ]
    }
  ]
}
